{
  "name": "CSS-Highlight",
  "version": "2.0.0",
  "manifest_version": 3,
  "description": "Highlight page elements by text content, attribute, or CSS selector — instantly, without opening DevTools.",
  "icons": {
    "16": "icons/icon16.PNG",
    "32": "icons/icon32.PNG",
    "48": "icons/icon48.PNG",
    "128": "icons/icon128.PNG"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CSS-Highlight",
    "default_icon": "icons/icon32.PNG"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ]
    }
  ],
  "permissions": ["storage"],
  "commands": {
    "highlight": {
      "suggested_key": { "default": "Ctrl+Shift+H", "mac": "Command+Shift+H" },
      "description": "Re-run last highlight"
    },
    "clear": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "Clear all highlights"
    }
  }
}